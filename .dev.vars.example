# Modified by CyberNova for the CloudForge fork (forked 2026-10-22). Originally Apache-2.0 (see LICENSES/Apache-2.0.txt).
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
# Optional fixed OIDC provider client secret. Configure OIDC_PROVIDER separately; never put this secret in JSON vars.
OIDC_CLIENT_SECRET=
# Git LFS: an R2 API token with Object Read & Write on the LFS bucket (S3-compatible credentials).
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Usage & cost (Site admin): an account API token with Account Analytics: Read. Optional.
CF_ANALYTICS_TOKEN=
# First-run setup: SHA-256 hash of the one-time setup code printed by `yarn cloudforge install`. Empty = no code needed.
SETUP_CODE_HASH=
# Actions secrets: encrypts the secrets repositories and site admins save (openssl rand -hex 32). Changing it
# makes every saved secret unreadable (they must be saved again). Empty = Actions secrets are off.
ACTIONS_SECRETS_KEY=
