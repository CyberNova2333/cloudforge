{
  "name": "cloudforge",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "node scripts/development/dev.mjs",
    "seed:demo": "node scripts/seed-demo/seed-demo.mjs",
    "cloudforge": "node scripts/cloudforge/cli.ts",
    "agents:sync": "node scripts/agents/sync-agents.mjs",
    "pack:npm": "node scripts/cloudforge/pack.mjs",
    "release:publish": "node scripts/release/release-publish.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "vite build && wrangler deploy",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p worker/tsconfig.json && tsc --noEmit -p scripts/cloudforge",
    "cf-typegen": "node scripts/cloudflare/cf-typegen.mjs",
    "notices": "node scripts/licensing/third-party-notices.mjs",
    "notices:check": "node scripts/licensing/third-party-notices.mjs --check",
    "auth:generate": "auth generate --config scripts/database/auth-schema-config.ts --output worker/src/db/auth.schema.ts -y",
    "auth:format": "prettier --write worker/src/db/auth.schema.ts",
    "auth:update": "yarn auth:generate && node scripts/database/fix-auth-schema.mjs && yarn auth:format",
    "db:generate": "node scripts/database/generate-db.mjs",
    "db:migrate:local": "wrangler d1 migrations apply DB --local --env dev",
    "db:migrate:prod": "wrangler d1 migrations apply DB --remote",
    "db:studio:dev": "drizzle-kit studio",
    "tail": "wrangler tail --format=pretty",
    "test": "vitest run --config scripts/cloudforge/vitest.config.ts && node scripts/testing/test-workers.mjs",
    "test:workers": "node scripts/testing/test-workers.mjs",
    "test:watch": "vitest --config worker/vitest.config.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,css,md,html}": "prettier --write"
  },
  "dependencies": {
    "@better-auth/core": "1.7.18",
    "@better-auth/oauth-provider": "1.7.18",
    "@better-auth/utils": "0.5.1",
    "@cloudflare/computer": "0.10.0",
    "@earendil-works/chord": "1.5.0",
    "@earendil-works/pi-ai": "1.5.0",
    "@earendil-works/pi-durable": "1.5.0",
    "@fontsource/figtree": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/inter-tight": "^5.3.0",
    "@hono/swagger-ui": "^0.6",
    "@hono/zod-openapi": "^1.3",
    "@primer/css": "^21",
    "@primer/octicons-react": "^19.42.0",
    "@primer/primitives": "^10",
    "@tanstack/react-query": "^5",
    "agent-robot-avatar": "0.7.2",
    "agents": "0.33.0",
    "animejs": "4.5.0",
    "aws4fetch": "^1.0.20",
    "better-auth": "^1.7",
    "clsx": "^2.1.1",
    "diff": "^9.0.0",
    "dompurify": "^3.4.17",
    "drizzle-orm": "^0.45",
    "highlight.js": "^11.12.0",
    "hono": "^4.13",
    "jose": "6.2.15",
    "marked": "^18.1.3",
    "mermaid": "^12.3.0",
    "node-diff3": "3.2.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "7.18.5",
    "yaml": "^2.9",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@clack/prompts": "^1.8.1",
    "@cloudflare/vite-plugin": "^1.67.0",
    "@cloudflare/vitest-pool-workers": "^0.23.0",
    "@cloudflare/workers-types": "^4",
    "@types/diff": "^8.0.0",
    "@types/node": "^26.6.6",
    "@types/react": "18",
    "@types/react-dom": "18",
    "@vitejs/plugin-react-swc": "^3",
    "auth": "1.7.18",
    "drizzle-kit": "^0.31",
    "esbuild": "0.28.2",
    "husky": "^9",
    "jsonc-parser": "^3.3.1",
    "lint-staged": "^16",
    "prettier": "^3",
    "typescript": "^5.8",
    "vite": "^7.3.7",
    "vitest": "^4.1.12",
    "wrangler": "^4"
  },
  "resolutions": {
    "vite": "^7.3.7",
    "undici": "7.30.1",
    "sharp": "0.35.5",
    "**/@esbuild-kit/core-utils/esbuild": "0.25.12",
    "**/zod": "^4.6.6"
  },
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://cnb.cool/CyberNova2333/cloudforge.git"
  },
  "packageManager": "pnpm@12.6.0"
}
